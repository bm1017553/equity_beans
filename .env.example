# Copy this file to .env and fill it in. npm start reads .env if it exists.

# Where MongoDB is running. The database is always "equity_beans".
MONGODB_URI=mongodb://localhost:27017

# Signs the login cookie. Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without one, the server makes a new one each start and everyone is logged out.
SESSION_SECRET=

PORT=3000
